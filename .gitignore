# =============================================================================
# PlantVision / Plant AI MVP — production-safe .gitignore
# FastAPI backend · Mobile web frontend · Supabase Cloud · YOLOv8 · ESP32
# =============================================================================
# Sections:
#   1.  Secrets
#   2.  Python
#   3.  Frontend / Node
#   4.  AI Models
#   5.  Datasets
#   6.  Build Artifacts
#   7.  Logs
#   8.  IDE
#   9.  OS Files
#   10. Temporary Files
#   11. Project-specific runtime
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Secrets / environment   (keep .env.example for onboarding)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example

# ESP32 firmware secrets — keep firmware/esp32/config.example.h for onboarding
firmware/esp32/config.h


# -----------------------------------------------------------------------------
# 2. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtualenvs
.venv/
venv/
env/
ENV/
.env.bak

# Test / type / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
*.cover

# Jupyter
.ipynb_checkpoints/


# -----------------------------------------------------------------------------
# 3. Frontend / Node   (keep package-lock.json for reproducible installs)
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
.parcel-cache/
.nyc_output/

# Auto-generated local app state
frontend/mobile-app/data/appdata.json

# Legacy import staging
frontend/_imports/


# -----------------------------------------------------------------------------
# 4. AI Models   (weights are large; keep registry/manifest + .gitkeep)
# -----------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.mlmodel
*.bin
*.h5
*.pkl

# Versioned checkpoint folder (keep marker files only)
artifacts/models/**
!artifacts/models/.gitkeep
!artifacts/models/**/.gitkeep
!artifacts/registry.json

# Training output trees
artifacts/train_runs/
ultralytics_runs/
checkpoints/
runs/
wandb/
mlruns/


# -----------------------------------------------------------------------------
# 5. Datasets   (heavy binaries; keep small READMEs / yaml scaffolds)
# -----------------------------------------------------------------------------
dataset/_imports/
dataset/cucumber/
datasets/
data/

# Common dataset archive formats
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz


# -----------------------------------------------------------------------------
# 6. Build Artifacts
# -----------------------------------------------------------------------------
dist/
build/
outputs/
output/
coverage/

# Node / bundler caches
.cache/
.next/
.nuxt/
.svelte-kit/
.turbo/


# -----------------------------------------------------------------------------
# 7. Logs
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# -----------------------------------------------------------------------------
# 8. IDE
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~


# -----------------------------------------------------------------------------
# 9. OS Files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini


# -----------------------------------------------------------------------------
# 10. Temporary Files
# -----------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.json.bak

# Local sqlite / on-disk DB snapshots
*.sqlite
*.sqlite3
*.db

# Local cache / export folders
cache/
local_cache/
exports/
reports/
screenshots/


# -----------------------------------------------------------------------------
# 11. Project-specific runtime
# -----------------------------------------------------------------------------
# User-uploaded scan images (kept locally per developer)
backend/uploads/
uploads/

# Local Obsidian Vault folder (personal project memory)
vault/


# =============================================================================
# NOTES
# -----------------------------------------------------------------------------
# Intentionally TRACKED (do not add to the ignore list):
#   .env.example                       — environment template for onboarding
#   artifacts/models/.gitkeep          — ensures model dir exists on a fresh clone
#   artifacts/registry.json            — model registry / manifest (small JSON)
#   firmware/esp32/config.example.h    — firmware secrets template
#   supabase/migrations/*.sql          — database schema migrations
#   docker-compose.yml                 — optional local Postgres
#   requirements.txt, package.json     — dependency manifests
#   README.md, SETUP_PHASE2.md         — setup docs
#
# Real model weights (*.pt / *.pth / *.onnx / *.engine / *.tflite / *.mlmodel)
# are always ignored — fetch them via the model registry / your team's bucket.
# =============================================================================
