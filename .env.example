# =====================================================================
# PlantVision — environment template
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# DO NOT COMMIT real Supabase passwords, service-role keys, or ESP32
# device secrets to this template.
# =====================================================================


# ---------------------------------------------------------------------
# Persistence backend
# ---------------------------------------------------------------------
# postgres = use Supabase Cloud (recommended for team development)
# memory   = in-process only (no DB needed; legacy MVP behaviour)
PERSISTENCE_BACKEND=postgres


# ---------------------------------------------------------------------
# Supabase Cloud connection (primary path)
# ---------------------------------------------------------------------
# Supabase Dashboard → Project → Settings → Database
#   → Connection string → "URI" → "Transaction pooler" (port 6543)
#
# Format:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<host>.pooler.supabase.com:6543/postgres
#
# Notes:
#   * The Transaction pooler (port 6543) is recommended for FastAPI / asyncpg.
#   * TLS is enforced automatically when the host ends in .supabase.co/.com.
#   * URL-encode <PASSWORD> if it contains special characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional Supabase client placeholders (only used if/when supabase-py is added)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here


# ---------------------------------------------------------------------
# Scan image storage (Phase 4)
# ---------------------------------------------------------------------
# Where /predict persists uploaded scan images.
#   supabase = upload to Supabase Storage bucket SUPABASE_STORAGE_BUCKET
#              (requires SUPABASE_URL + SUPABASE_SERVICE_KEY above);
#              survives Railway / container redeploys.
#   local    = keep writing under backend/uploads/ (legacy behaviour).
#   off      = also forces local fallback (alias for local).
#
# When Supabase Storage is selected but the upload fails (network /
# auth / 5xx), the backend automatically falls back to backend/uploads/
# so /predict never breaks.
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=scan-images


# ---------------------------------------------------------------------
# Optional: local Postgres (only if NOT using Supabase Cloud)
# ---------------------------------------------------------------------
# Uncomment and edit if you run `docker compose up -d` for local dev.
# DATABASE_URL above wins when both are set.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=plantvision_dev
# POSTGRES_DB=plantvision
# POSTGRES_HOST=localhost
# POSTGRES_PORT=54322


# ---------------------------------------------------------------------
# API server (uvicorn / FastAPI)
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000


# ---------------------------------------------------------------------
# CORS allowlist (Phase 4)
# ---------------------------------------------------------------------
# Comma-separated list of fully-qualified origins allowed to call the
# FastAPI backend. Leave unset (or "*") to keep the legacy wide-open
# behaviour — recommended ONLY for local dev / demo. For production
# deployments behind a real domain, pin the list to your actual
# frontend origins, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,https://plantvision.vercel.app
CORS_ALLOWED_ORIGINS=*


# ---------------------------------------------------------------------
# Frontend dev server (Node)
# ---------------------------------------------------------------------
FRONTEND_PORT=3000


# ---------------------------------------------------------------------
# Persistence toggles (default: true)
# ---------------------------------------------------------------------
# Flip any of these to "false" to skip writing the corresponding table.
PERSIST_EVENTS=true
PERSIST_SENSOR_HISTORY=true
PERSIST_SCAN_HISTORY=true


# ---------------------------------------------------------------------
# Google Gemini — the ONLY AI engine (diagnosis + reasoning)
# ---------------------------------------------------------------------
# One key powers every AI feature: photo diagnosis (/predict, /analyze,
# image /report) and reasoning (/chat, /analyze). Get a key at
# https://aistudio.google.com/app/apikey  (docs: https://ai.google.dev/gemini-api/docs/api-key)
#
# Server-side only: never put this key in frontend code, env.js, Vercel
# public variables or browser storage. Without it the AI routes return
# HTTP 503 {"error": "gemini_not_configured"} — there is no local fallback.
GEMINI_API_KEY=

# Model for both steps. Override either step independently if needed.
# gemini-2.5-flash is closed to new API keys.
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_DIAGNOSIS_MODEL=
# GEMINI_REASONING_MODEL=
# (used for the one retry when the main model is overloaded, times out or is not available; "none" turns it off)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Request handling (defaults shown)
# (per attempt)
# GEMINI_TIMEOUT_SECONDS=25
# (whole call, including the retry)
# GEMINI_DEADLINE_SECONDS=30
# (transient errors only (5xx, timeout, network, per-minute 429))
# GEMINI_MAX_RETRIES=1
# (exponential backoff: 1s, 2s, 4s ... with jitter)
# GEMINI_BACKOFF_BASE_SECONDS=1
# GEMINI_BACKOFF_MAX_SECONDS=8

# Generation (defaults shown)
# (Gemini 2.x only; Gemini 3.x always uses the model's default temperature)
# GEMINI_DIAGNOSIS_TEMPERATURE=0.2
# GEMINI_REASONING_TEMPERATURE=0.4
# (includes "thinking" tokens)
# GEMINI_MAX_OUTPUT_TOKENS=8192
# (Gemini 3.x: minimal | low | medium | high; unset = model default)
# GEMINI_THINKING_LEVEL=
# (Gemini 2.x only: unset = model default; 0 disables thinking on Flash)
# GEMINI_THINKING_BUDGET=

# Cost control (defaults shown)
# (reject uploads larger than 10 MB (HTTP 413))
# MAX_UPLOAD_BYTES=10485760
# (downscale long edge before sending)
# GEMINI_MAX_IMAGE_SIDE=1536
# GEMINI_JPEG_QUALITY=85
# (reuse a diagnosis for an identical photo; 0 disables)
# GEMINI_CACHE_TTL_SECONDS=3600
# GEMINI_CACHE_MAX_ENTRIES=256


# ---------------------------------------------------------------------
# Legacy local AI — DISABLED (kept for reference / training only)
# ---------------------------------------------------------------------
# The YOLOv8 router, Pl@ntNet identifier and Ollama narrative code is kept
# in backend/models/ but production never loads it, so these variables
# have no effect on the running API. The training scripts under
# training/ and scripts/ still read the YOLO paths.
# ROSE_WEIGHTS_PATH=artifacts/models/rose/weights.pt
# MONEY_PLANT_WEIGHTS_PATH=artifacts/models/money_plant/weights.pt
# CUCUMBER_WEIGHTS_PATH=artifacts/models/cucumber/weights.pt
# YOLO_CONF=0.25
# YOLO_IMGSZ=640
# YOLO_DATA_YAML=
# CLASSIFICATION_DATASET_ROOT=
# MODEL_REGISTRY_PATH=
# PLANT_ID_MODEL=plantnet
# PLANTNET_API_KEY=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=llama3.1


# ---------------------------------------------------------------------
# Admin dataset-annotation providers (Phase 8) — optional
# ---------------------------------------------------------------------
# Used only by the admin /admin/providers annotation tools for building
# training data. They are NOT used to diagnose user scans. The Gemini
# annotator reuses GEMINI_API_KEY above. Leave blank to skip.
ANTHROPIC_API_KEY=
# Override the Claude vision model (defaults to claude-sonnet-4-20250514)
ANTHROPIC_VISION_MODEL=
OPENAI_API_KEY=
# Override the OpenAI vision model (defaults to gpt-4o)
OPENAI_VISION_MODEL=gpt-4o
KIMI_API_KEY=
ROBOFLOW_API_KEY=
# Required alongside ROBOFLOW_API_KEY — without both, Roboflow stays
# stubbed rather than voting with an unrelated public model.
ROBOFLOW_MODEL_ENDPOINT=


# ---------------------------------------------------------------------
# Dataset upload path override (Task 1)
# ---------------------------------------------------------------------
# Override where uploaded training datasets are stored.
# Defaults to <repo_root>/dataset/uploads if unset.
# Point at a Railway Volume for production persistence.
DATASET_UPLOADS_PATH=


# ---------------------------------------------------------------------
# Survival score weights (advanced — defaults usually fine)
# ---------------------------------------------------------------------
# The four weights should sum to ~1.0.
SURVIVAL_WEIGHT_DISEASE=0.40
SURVIVAL_WEIGHT_SOIL_MOISTURE=0.25
SURVIVAL_WEIGHT_TEMPERATURE=0.20
SURVIVAL_WEIGHT_HUMIDITY=0.15

