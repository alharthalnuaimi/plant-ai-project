# =====================================================================
# PlantVision — environment template
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# DO NOT COMMIT real Supabase passwords, service-role keys, or ESP32
# device secrets to this template.
# =====================================================================


# ---------------------------------------------------------------------
# Persistence backend
# ---------------------------------------------------------------------
# postgres = use Supabase Cloud (recommended for team development)
# memory   = in-process only (no DB needed; legacy MVP behaviour)
PERSISTENCE_BACKEND=postgres


# ---------------------------------------------------------------------
# Supabase Cloud connection (primary path)
# ---------------------------------------------------------------------
# Supabase Dashboard → Project → Settings → Database
#   → Connection string → "URI" → "Transaction pooler" (port 6543)
#
# Format:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<host>.pooler.supabase.com:6543/postgres
#
# Notes:
#   * The Transaction pooler (port 6543) is recommended for FastAPI / asyncpg.
#   * TLS is enforced automatically when the host ends in .supabase.co/.com.
#   * URL-encode <PASSWORD> if it contains special characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional Supabase client placeholders (only used if/when supabase-py is added)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here


# ---------------------------------------------------------------------
# Scan image storage (Phase 4)
# ---------------------------------------------------------------------
# Where /predict persists uploaded scan images.
#   supabase = upload to Supabase Storage bucket SUPABASE_STORAGE_BUCKET
#              (requires SUPABASE_URL + SUPABASE_SERVICE_KEY above);
#              survives Railway / container redeploys.
#   local    = keep writing under backend/uploads/ (legacy behaviour).
#   off      = also forces local fallback (alias for local).
#
# When Supabase Storage is selected but the upload fails (network /
# auth / 5xx), the backend automatically falls back to backend/uploads/
# so /predict never breaks.
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=scan-images


# ---------------------------------------------------------------------
# Optional: local Postgres (only if NOT using Supabase Cloud)
# ---------------------------------------------------------------------
# Uncomment and edit if you run `docker compose up -d` for local dev.
# DATABASE_URL above wins when both are set.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=plantvision_dev
# POSTGRES_DB=plantvision
# POSTGRES_HOST=localhost
# POSTGRES_PORT=54322


# ---------------------------------------------------------------------
# API server (uvicorn / FastAPI)
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000


# ---------------------------------------------------------------------
# CORS allowlist (Phase 4)
# ---------------------------------------------------------------------
# Comma-separated list of fully-qualified origins allowed to call the
# FastAPI backend. Leave unset (or "*") to keep the legacy wide-open
# behaviour — recommended ONLY for local dev / demo. For production
# deployments behind a real domain, pin the list to your actual
# frontend origins, e.g.:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,https://plantvision.vercel.app
CORS_ALLOWED_ORIGINS=*


# ---------------------------------------------------------------------
# Frontend dev server (Node)
# ---------------------------------------------------------------------
FRONTEND_PORT=3000


# ---------------------------------------------------------------------
# Persistence toggles (default: true)
# ---------------------------------------------------------------------
# Flip any of these to "false" to skip writing the corresponding table.
PERSIST_EVENTS=true
PERSIST_SENSOR_HISTORY=true
PERSIST_SCAN_HISTORY=true


# ---------------------------------------------------------------------
# YOLOv8 model
# ---------------------------------------------------------------------
# Path is relative to repo root; the actual weight file is git-ignored.
YOLO_WEIGHTS_PATH=artifacts/models/cucumber_yolov8.pt
YOLO_CONF=0.25
YOLO_IMGSZ=640

# Optional override paths (leave blank to use defaults)
YOLO_DATA_YAML=
CLASSIFICATION_DATASET_ROOT=
MODEL_REGISTRY_PATH=


# ---------------------------------------------------------------------
# Image preprocessing
# ---------------------------------------------------------------------
MAX_IMAGE_SIDE=1024
STANDARDIZE_IMAGE_ON_PREDICT=false


# ---------------------------------------------------------------------
# Plant identification backend (Phase Final — pluggable, defaults to plantnet)
# ---------------------------------------------------------------------
# plantnet = Pl@ntNet v2 API wrapper (default). Reads PLANTNET_API_KEY
#            below. If the key is missing or any HTTP call fails, the
#            wrapper transparently falls back to the stub so /predict
#            never breaks.
# stub     = ship-with-MVP heuristic that locks to cucumber (always
#            available, no network).
PLANT_ID_MODEL=plantnet
# Get a free Pl@ntNet API key at https://my.plantnet.org/ and paste it here:
PLANTNET_API_KEY=
# DEPRECATED: PLANT_ID_API_KEY is still read as a fallback for backward
# compatibility, but new deployments should set PLANTNET_API_KEY above.
# PLANT_ID_API_KEY=


# ---------------------------------------------------------------------
# Plant Assistant LLM — Google Gemini (recommended)
# ---------------------------------------------------------------------
# Used by /chat to generate the structured plant assistant response
# (plant summary + health + risk + care + environmental advice). When
# GEMINI_API_KEY is empty the backend falls back to a deterministic
# rule-based narrative so demos still work offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ---------------------------------------------------------------------
# Optional Ollama LLM (legacy — kept for local-first dev, safe to leave blank)
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1


# ---------------------------------------------------------------------
# Survival score weights (advanced — defaults usually fine)
# ---------------------------------------------------------------------
# The four weights should sum to ~1.0.
SURVIVAL_WEIGHT_DISEASE=0.40
SURVIVAL_WEIGHT_SOIL_MOISTURE=0.25
SURVIVAL_WEIGHT_TEMPERATURE=0.20
SURVIVAL_WEIGHT_HUMIDITY=0.15
