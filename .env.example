# =====================================================================
# PlantVision — environment template
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# DO NOT COMMIT real Supabase passwords, service-role keys, or ESP32
# device secrets to this template.
# =====================================================================


# ---------------------------------------------------------------------
# Persistence backend
# ---------------------------------------------------------------------
# postgres = use Supabase Cloud (recommended for team development)
# memory   = in-process only (no DB needed; legacy MVP behaviour)
PERSISTENCE_BACKEND=postgres


# ---------------------------------------------------------------------
# Supabase Cloud connection (primary path)
# ---------------------------------------------------------------------
# Supabase Dashboard → Project → Settings → Database
#   → Connection string → "URI" → "Transaction pooler" (port 6543)
#
# Format:
#   postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<host>.pooler.supabase.com:6543/postgres
#
# Notes:
#   * The Transaction pooler (port 6543) is recommended for FastAPI / asyncpg.
#   * TLS is enforced automatically when the host ends in .supabase.co/.com.
#   * URL-encode <PASSWORD> if it contains special characters.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Optional Supabase client placeholders (only used if/when supabase-py is added)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here


# ---------------------------------------------------------------------
# Optional: local Postgres (only if NOT using Supabase Cloud)
# ---------------------------------------------------------------------
# Uncomment and edit if you run `docker compose up -d` for local dev.
# DATABASE_URL above wins when both are set.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=plantvision_dev
# POSTGRES_DB=plantvision
# POSTGRES_HOST=localhost
# POSTGRES_PORT=54322


# ---------------------------------------------------------------------
# API server (uvicorn / FastAPI)
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000


# ---------------------------------------------------------------------
# Frontend dev server (Node)
# ---------------------------------------------------------------------
FRONTEND_PORT=3000


# ---------------------------------------------------------------------
# Persistence toggles (default: true)
# ---------------------------------------------------------------------
# Flip any of these to "false" to skip writing the corresponding table.
PERSIST_EVENTS=true
PERSIST_SENSOR_HISTORY=true
PERSIST_SCAN_HISTORY=true


# ---------------------------------------------------------------------
# YOLOv8 model
# ---------------------------------------------------------------------
# Path is relative to repo root; the actual weight file is git-ignored.
YOLO_WEIGHTS_PATH=artifacts/models/cucumber_yolov8.pt
YOLO_CONF=0.25
YOLO_IMGSZ=640

# Optional override paths (leave blank to use defaults)
YOLO_DATA_YAML=
CLASSIFICATION_DATASET_ROOT=
MODEL_REGISTRY_PATH=


# ---------------------------------------------------------------------
# Image preprocessing
# ---------------------------------------------------------------------
MAX_IMAGE_SIDE=1024
STANDARDIZE_IMAGE_ON_PREDICT=false


# ---------------------------------------------------------------------
# Optional Ollama LLM (assistant only; safe to leave blank)
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1


# ---------------------------------------------------------------------
# Survival score weights (advanced — defaults usually fine)
# ---------------------------------------------------------------------
# The four weights should sum to ~1.0.
SURVIVAL_WEIGHT_DISEASE=0.40
SURVIVAL_WEIGHT_SOIL_MOISTURE=0.25
SURVIVAL_WEIGHT_TEMPERATURE=0.20
SURVIVAL_WEIGHT_HUMIDITY=0.15
