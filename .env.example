# =====================================================================
# PlantVision — Local environment example
# Copy to `.env` and adjust as needed. `.env` is git-ignored.
# =====================================================================

# ---- Postgres / Supabase (LOCAL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=plantvision_dev
POSTGRES_DB=plantvision
POSTGRES_HOST=localhost
POSTGRES_PORT=54322

# Optional Supabase Studio / meta service ports
META_PORT=54323
STUDIO_PORT=54324

# Backend persistence backend: "postgres" or "memory"
# memory = in-process (legacy MVP), postgres = use the local DB above
PERSISTENCE_BACKEND=postgres

# Connection string built from the parts above (override if needed)
DATABASE_URL=postgresql://postgres:plantvision_dev@localhost:54322/plantvision

# Supabase placeholders (only used if/when we add the supabase-py client)
SUPABASE_URL=http://localhost:54322
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Toggle: persist analytics events / sensor history to DB (true/false)
PERSIST_EVENTS=true
PERSIST_SENSOR_HISTORY=true
PERSIST_SCAN_HISTORY=true

# ---- Frontend dev server (Node) ----
FRONTEND_PORT=3000
